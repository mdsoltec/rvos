[Unit]
Description=RetroVault OS — shell (Chromium kiosk via cage/Wayland)
After=systemd-user-sessions.service retrovault-bridge.service
Conflicts=getty@tty1.service

[Service]
User=rv
Group=tty
SupplementaryGroups=input video render audio
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/bin/cage -s -- /opt/retrovault/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
