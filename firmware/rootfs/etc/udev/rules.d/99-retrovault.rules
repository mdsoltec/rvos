# RetroVault OS — permissões de entrada e backlight

# Gamepads/encoder USB legíveis pelo usuário do kiosk
KERNEL=="js[0-9]*", SUBSYSTEM=="input", GROUP="input", MODE="0664"
KERNEL=="event*", SUBSYSTEM=="input", GROUP="input", MODE="0664", TAG+="uaccess"

# Backlight do LCD ajustável pela bridge
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod 0666 /sys/class/backlight/%k/brightness"

# Cada partição de pendrive com filesystem recebe montagem isolada em /media/rv/<dispositivo>.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", TAG+="systemd", ENV{SYSTEMD_WANTS}+="retrovault-usb@%k.service"
